# All settings are optional. Copy this file to .env only if your launcher loads it.
# The package itself reads process environment variables and never loads secrets implicitly.
SEMANTIC_SEARCH_MODEL_NAME=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
SEMANTIC_SEARCH_VECTOR_BACKEND=auto
SEMANTIC_SEARCH_SEARCH_RESULTS=8
SEMANTIC_SEARCH_TOP_K=5
SEMANTIC_SEARCH_FETCH_K=20
SEMANTIC_SEARCH_CHUNK_SIZE_TOKENS=256
SEMANTIC_SEARCH_CHUNK_OVERLAP_TOKENS=32
SEMANTIC_SEARCH_MAX_CONTEXT_TOKENS=1200
SEMANTIC_SEARCH_SCORE_THRESHOLD=0.15
SEMANTIC_SEARCH_MMR_LAMBDA=0.7
SEMANTIC_SEARCH_ALLOW_PRIVATE_NETWORK=false
SEMANTIC_SEARCH_USER_AGENT=semantic-search-agents/0.2
